generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
    elder
    caregiver
    admin
}
model User {
    id Int @id @unique @default(autoincrement())
    cpf String @unique @db.VarChar(11)
    email String @unique
    name String @db.VarChar(100)
    phone String @db.VarChar(15)
    passwordHash String @map("password_hash")
    role Role
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    elderProfile ElderProfile?
    caregiverProfile CaregiverProfile?
    pushToken PushToken[]

    @@map("user")
}

model ElderProfile {
    userId Int @unique @map("user_id")
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    
    caregiverId Int? @unique @map("caregiver_id")
    caregiver CaregiverProfile? @relation(fields: [caregiverId], references: [userId], onDelete: SetNull)

    deviceId String? @unique @db.VarChar(8) @map("device_id")

    lastBpm Int? @map("last_bpm")
    lastBpmMeasuredAt DateTime? @map("last_bpm_measured_at")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    heartRateMeasurements HeartRateMeasurement[]

    @@map("elder_profile")
}

model CaregiverProfile {
    userId Int @unique @map("user_id")
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    elder ElderProfile?

    createdAt DateTime @default(now()) @map("created_at")

    @@map("caregiver_profile")
}

enum Platform {
    ios
    android
}

model PushToken {
    id Int @unique @default(autoincrement())
    userId Int @unique @map("user_id")
    user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
    
    expoTokenPush String @unique @map("expo_token_push")
    platform Platform
    osVersion String @map("os_version")
    
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    lastActiveAt DateTime? @map("last_active_at")
    lastSentAt DateTime? @map("last_sent_at")

    @@index([userId])
    @@index([lastActiveAt])

    @@map("push_token")
}

enum Status {
    NORMAL
    CRITICAL
}

model HeartRateMeasurement {
    id Int @unique @default(autoincrement())

    elderId Int @map("elder_id")
    elder ElderProfile @relation(fields: [elderId], references: [userId], onDelete: Cascade)

    bpm Int
    measuredAt DateTime @map("measured_at")

    source String @db.VarChar(30)
    externalReadingId String? @map("external_reading_id") @db.VarChar(100)
    rawPayload Json? @map("raw_payload")

    status Status @default(NORMAL)
    consecutiveCriticalReadings Int @default(0)
    consecutiveNormalReadings Int @default(0)
    criticalSince DateTime? 

    createdAt DateTime @default(now()) @map("created_at")

    @@index([elderId, measuredAt])
    @@map("heart_rate_measurements")
}


